# Copy to .env.local and fill in real values.

# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Groq (https://console.groq.com/keys) - free tier
GROQ_API_KEY=YOUR-GROQ-KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Optional TMDb (https://www.themoviedb.org/settings/api) - free. Leave empty to
# keep the Watchlist on manual entry; the search panel simply won't render.
TMDB_API_KEY=

# Optional Spotify (https://developer.spotify.com/dashboard) - leave empty to disable Our Songs integration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Web Push (Pulse module). Generate with: node scripts/generate-vapid.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Secret for the daily anniversary cron (/api/cron/anniversaries). Use any long
# random string; set the SAME value as a GitHub repo secret named CRON_SECRET.
CRON_SECRET=
# Optional: timezone used to resolve "today" for date-only anniversaries.
CRON_TZ=America/New_York

# Site URL (used for auth redirects). In production set to your deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
